@* Müşteri bilgileri formu: EditForm + DataAnnotationsValidator + ValidationMessage.
   Geçerli gönderimde CustomerInfo nesnesi OnValidSubmit EventCallback'i ile üst bileşene iletilir. *@
<section class="customer card" aria-labelledby="customer-title">
    <header class="block-head">
        <span class="step" aria-hidden="true">3</span>
        <div>
            <h2 id="customer-title">Müşteri bilgileri</h2>
            <p><span class="req" aria-hidden="true">*</span> ile işaretli alanlar zorunludur.</p>
        </div>
    </header>

    <EditForm Model="model" OnValidSubmit="HandleValidSubmit" OnInvalidSubmit="HandleInvalidSubmit" novalidate>
        <DataAnnotationsValidator />

        @if (showInvalidNotice)
        {
            <div class="form-alert">
                <AlertBox Type="danger" Title="Form gönderilemedi">
                    Lütfen kırmızı ile işaretlenen alanları düzeltin.
                </AlertBox>
            </div>
        }

        <div class="form-grid">
            <div class="field full">
                <label for="fullName">Ad soyad <span class="req" aria-hidden="true">*</span></label>
                <div class="input-wrap">
                    <Icon Name="user" Size="18" />
                    <InputText id="fullName" class="form-control" @bind-Value="model.FullName" @ref="nameInput"
                               autocomplete="name" placeholder="Örn. Ayşe Yılmaz" aria-required="true"
                               maxlength="60" />
                </div>
                <ValidationMessage For="() => model.FullName" />
            </div>

            <div class="field">
                <label for="email">E-posta <span class="req" aria-hidden="true">*</span></label>
                <div class="input-wrap">
                    <Icon Name="mail" Size="18" />
                    <InputText id="email" type="email" class="form-control" @bind-Value="model.Email"
                               autocomplete="email" inputmode="email" placeholder="ad@ornek.com"
                               aria-required="true" maxlength="100" />
                </div>
                <ValidationMessage For="() => model.Email" />
            </div>

            <div class="field">
                <label for="phone">Cep telefonu <span class="req" aria-hidden="true">*</span></label>
                <div class="input-wrap">
                    <Icon Name="phone" Size="18" />
                    <InputText id="phone" type="tel" class="form-control" @bind-Value="model.Phone"
                               autocomplete="tel" inputmode="tel" placeholder="0532 123 45 67"
                               aria-required="true" maxlength="17" />
                </div>
                <ValidationMessage For="() => model.Phone" />
            </div>

            <div class="field full">
                <div class="terms">
                    <InputCheckbox id="terms" @bind-Value="model.AcceptTerms" />
                    <label for="terms">
                        Kiralama koşullarını okudum; 21 yaşından büyük olduğumu ve en az 2 yıllık ehliyetim
                        bulunduğunu onaylıyorum. <span class="req" aria-hidden="true">*</span>
                    </label>
                </div>
                <ValidationMessage For="() => model.AcceptTerms" />
            </div>
        </div>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="form-alert">
                <AlertBox Type="danger" Title="Rezervasyon oluşturulamadı">@ErrorMessage</AlertBox>
            </div>
        }

        <div class="actions">
            <button type="button" class="btn btn-ghost" @onclick="OnCancel" disabled="@IsSubmitting">Vazgeç</button>
            <button type="submit" class="btn btn-primary btn-lg" disabled="@IsSubmitting">
                @if (IsSubmitting)
                {
                    <span class="spinner" aria-hidden="true"></span>
                    <span>Kaydediliyor…</span>
                }
                else
                {
                    <Icon Name="check" Size="18" />
                    <span>Rezervasyonu Onayla</span>
                }
            </button>
        </div>
    </EditForm>
</section>

@code {
    [Parameter] public EventCallback<CustomerInfo> OnValidSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public bool IsSubmitting { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }

    private readonly CustomerInfo model = new();
    private InputText? nameInput;
    private bool showInvalidNotice;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Form açıldığında klavye/ekran okuyucu kullanıcıları için ilk alana odaklan
        if (firstRender && nameInput?.Element is ElementReference element)
        {
            await element.FocusAsync();
        }
    }

    private Task HandleValidSubmit()
    {
        showInvalidNotice = false;
        return OnValidSubmit.InvokeAsync(model);
    }

    private void HandleInvalidSubmit() => showInvalidNotice = true;
}
